# Bluetooth
bluetooth.device.default_name=realme GT neo 5

# Graphics
debug.sf.frame_rate_multiple_threshold=144
ro.surface_flinger.game_default_frame_rate_override=144
ro.surface_flinger.set_idle_timer_ms=250
ro.surface_flinger.set_touch_timer_ms=300

# Radio
persist.radio.multisim.config=dsds

# USB
vendor.usb.product_string=realme GT neo 5

# Disable screen gamma
sys.brightness.disable_gamma_conversion=1
